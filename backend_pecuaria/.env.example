# Porta do servidor (default: 3000)
PORT=3000

# Segredo para assinatura de Tokens JWT
JWT_SECRET=super_secret_jwt_key_here

# Expiração do token (ex: 30d, 2h, etc)
JWT_EXPIRES_IN=30d

# Origens permitidas (CORS). Separe por vírgula ou coloque * para dev (não recomendado em prod)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Provedor de E-mail para recuperação de senha (Simulação se vazio)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@agroapp.com
